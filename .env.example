# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# --- Resend (email sending: signup confirmations + launch broadcast) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx   # Resend API key
RESEND_FROM=Spawn <onboarding@resend.dev>    # Verified sender; change to your domain before launch

# --- Cloudflare D1 (broadcast script reads/writes subscribers over REST) ---
CF_D1_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx   # Cloudflare account id
CF_D1_DATABASE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx   # D1 database id from `wrangler d1 create`
CF_D1_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx   # CF API token scoped to D1 read/write

# --- Cloudflare Turnstile (spam protection for the subscribe form) ---
TURNSTILE_SECRET_KEY=0x4xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx   # Turnstile secret key; set via `wrangler pages secret put`
TURNSTILE_SITE_KEY=1x00000000000000000000AA   # Turnstile public site key; goes in src/pages/index.astro
